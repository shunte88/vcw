# Build output. Two workspaces, two target directories: the product at the root and
# the Phase 0 spikes, which are excluded from it (ADR-0003).
/target
/spikes/target
/app/target

# Benchmark scratch databases (S2 spike output)
/.bench/
*.vcw
*.vcw-wal
*.vcw-shm

# `tools/` is tracked. It held VRipr training material that has since moved out,
# and the ignore that covered it hid three files the repo depends on: the
# third-party reader that proves the format is open (WP-18's exit criterion),
# the release checksum tool CI runs, and the icon renderer.
# `crates/cli/tests/every_file_the_build_needs_is_tracked.rs` is the guard.

resume
bump.sh
vcw_kb.txt
# Cargo lock (keep for binaries, discard for libraries - this is a binary)
# Cargo.lock

# Editor temporaries
*.swp
*.swo
*.orig
*~

# IDE
.vscode/
.idea/
*.iml

# macOS
.DS_Store
**/.DS_Store

# Test / scratch audio files
*.wav
*.flac
*.mp3
*.ogg
*.aiff
!/assets/**

# ...but test fixtures are tracked deliberately: they are the regression evidence
# for the detector port (REQUIREMENTS §41, PROJECT_PLAN WP-17 / milestone M3), so
# the audio ignores above must not swallow them.
!**/tests/fixtures/**
!/fixtures/**

# The bulk labeled corpus (~294 MB, 595 excerpt/label pairs) is NOT tracked -
# fetched on demand by scripts/fetch-corpus.sh. Only the curated subset under
# /fixtures/boundary/ lives in the repo.
/fixtures/corpus-full/

# Audacity fixture projects used by the AUP3/AUP4 import tests are tracked.
!**/tests/fixtures/**/*.aup3
!**/tests/fixtures/**/*.aup4

# Temporary analysis WAV (written to /tmp but just in case)
/tmp/vcw_analysis_*.wav

# Frontend build artifacts and dependencies. The generated TypeScript under
# `app/ui/src/bindings/` is NOT here: it is committed on purpose so the frontend
# typechecks without a Rust toolchain, and a test regenerates and compares it.
node_modules/
**/dist/
*.tsbuildinfo

# Regenerated by tauri-build on every build.
**/src-tauri/gen/schemas/

# The CLI staged for the bundler by tools/stage-cli.sh: a copy of a build
# artifact, named for the target triple it was built for.
/app/src-tauri/binaries/

# Claude Code local config
.claude/

# Environment / secrets
.env
*.env.local

# Config override for local dev (real config lives in ~/.config/vcw/)
vcw.toml

# Python bytecode from the spike probes. Tracked by accident until WP-17,
# which is when a second machine pulled the repo and reported a dirty tree.
__pycache__/
*.pyc
