#!/usr/bin/env bash
#
#  soak-nightly.cron
#
#  VCW - The Vinyl Capture Workstation
#  (c) 2026 Stue Hunter
#
#  §41's endurance soak, nightly, on a machine that is ours.
#
# MIT License - see the header in any Rust source file for the full text.
#
# Two hours of real-time capture - one with the waveform window open and one
# without - is the only leg that can see what a fast run cannot: memory over
# thousands of commits, the WAL over hundreds of checkpoint attempts, and a
# real album side's worth of file. It used to run on a GitHub runner, where a
# shared CPU and a shared disk cost it 54 overruns and 25,920 dropped frames
# and the byte verifier failed it on the neighbors' account. So it runs here,
# where nothing else does, and the latency gates stay on because they can.
#
# Safe on the dev box, which since 2026-10-17 is also the soak host: this
# reads the tree, writes only to $out, and touches git not at all.
#
#   crontab -e
#   17 3 * * *  /data2/vcw/scripts/soak-nightly.cron >> /data2/vcw-soak/cron.log 2>&1
#
set -euo pipefail

repo=${VCW_REPO:-/data2/vcw}
out=${VCW_SOAK_OUT:-/data2/vcw-soak}
keep=${VCW_SOAK_KEEP:-14}

# The short leg's corpus case, which a hosted runner can never do: a real rip
# fed through the writer and read back byte for byte. The harness skips it when
# the file is not there, so an export here costs a soak host that has no corpus
# nothing. Any one of the 62 will do - the property is that the bytes come back
# out, not which record they are.
: "${VCW_RIP:=$(ls -1 /data2/source_rips/*.wav 2>/dev/null | head -1)}"
[ -r "${VCW_RIP:-}" ] && export VCW_RIP || unset VCW_RIP

mkdir -p "$out"

# Do not soak a machine somebody is still using.
#
# A contended soak does not fail honestly, it fails on the neighbors: a
# 90-minute run on 2026-09-25 took 28 overruns and a 965 ms commit against a
# 250 ms budget, all of it inside the ten minutes a test suite was running
# beside it. Since 2026-10-17 the soak host is also the dev box, so "nothing
# else is running at 03:17" is an assumption and not a fact - a late night
# ends with a build still going, and the morning gets a red that is about the
# evening rather than about the code.
#
# So the precondition is checked rather than assumed, and a busy box is a skip
# and not a failure: exit 0, one line in the cron log, try again tomorrow. The
# one-minute average is the right one of the three - it is asking what is
# happening now, not what happened over the last quarter of an hour. Two is
# loose enough for the housekeeping any box does unprompted and tight enough
# to catch one `cargo build`, which is the thing that actually spoils a run.
maxload=${VCW_SOAK_MAXLOAD:-2.0}
load=$(cut -d' ' -f1 /proc/loadavg)
if awk -v l="$load" -v m="$maxload" 'BEGIN { exit !(l > m) }'; then
    printf '%s skipped: load %s over %s, the box is busy\n' \
        "$(date -u +%Y%m%dT%H%M%SZ)" "$load" "$maxload"
    exit 0
fi

stamp=$(date -u +%Y%m%dT%H%M%SZ)
run="$out/$stamp"
mkdir -p "$run"

# Soak the tree as it stands, and say what that was.
#
# This used to fetch and `checkout --force origin/main` first, which is how a
# second box got the code when there was a second box. There is one box since
# 2026-10-17, and on it that line was a 03:17 alarm clock that discarded
# whatever was uncommitted in the only checkout on the machine - which is what
# it did on 2026-10-19. The sync it was doing is not needed and the force
# never was.
#
# What the force also bought was the guarantee that a soak measured a commit
# somebody could go back to. That is kept by reporting rather than by
# enforcing: head.txt names the commit and lists anything modified on top of
# it, so a number from a dirty tree is still a number you can read honestly
# instead of one that quietly is not reproducible. A tree too broken to soak
# fails at the release build below, where `set -e` stops it.
cd "$repo"
{
    echo "soaking $(git rev-parse --short HEAD) at $stamp"
    dirty=$(git status --porcelain --untracked-files=no)
    [ -z "$dirty" ] && echo "tree clean" || printf 'tree dirty:\n%s\n' "$dirty"
} | tee "$run/head.txt"

# Release, not debug: a soak spends its time in the deinterleave, the summaries
# and the CRC, and a debug build of those changes what the run is measuring.
cargo build --release -p vcw-cli

# No VCW_SHARED here. That variable is for a machine we do not own, and the
# whole point of this host is that the latency gates mean something on it.

# The short leg first, which used to run in CI on every push and does not any
# more: five quarter-minute runs of fault injection and byte verification, and
# a canary for the two hours behind it. Its leg names do not collide with the
# nightly's, so both write into the same directory. If it fails there is
# nothing to learn from spending two hours on the long one.
status=0
scripts/soak-harness.sh short "$run" || status=$?
if [ "$status" -eq 0 ]; then
    scripts/soak-harness.sh nightly "$run" || status=$?
fi

# /data2 is where the audio goes and it is not free: keep the logs, which are
# the evidence, and drop the projects, which are regenerable.
find "$run" -name '*.vcw*' -delete
printf 'exit %d\n' "$status" > "$run/verdict.txt"

# Oldest first, keeping the last $keep nights of logs.
ls -1d "$out"/*Z 2>/dev/null | sort | head -n -"$keep" | xargs -r rm -rf

exit "$status"
